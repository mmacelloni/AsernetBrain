# Segreti e credenziali (globali, per-utente e per-cliente)
.env
.env.*
**/secrets.yaml
**/credentials.json

# Fonti grezze (raw/): restano sul disco locale dell'utente che fa l'ingest,
# NON salgono sul repo Git della VPS. Nei file derivati viene tracciato user + path + sha256.
raw/*
!raw/.gitkeep
!raw/clients/
raw/clients/*
!raw/clients/.gitkeep

# Database SQLite e cache locali (DataOS / IntelOS per cliente)
*.db
*.db-journal
*.db-wal
*.sqlite
clients/**/data/*.db

# Angolino Riservato dell'Utente (personal/): sub-repo Git privato isolato per utente
# (/srv/git/personal/<utente>.git). Ignorato dal repo aziendale condiviso.
personal/

# Obsidian workspace & plugin locali per-macchina
.trash/
.obsidian/workspace*.json
.obsidian/plugins/obsidian-livesync/

# Configurazioni locali Claude per-macchina / per-utente
.claude/settings.local.json
.claude/settings.local.json.*

# Python & Node
__pycache__/
*.pyc
.venv/
node_modules/
.DS_Store
